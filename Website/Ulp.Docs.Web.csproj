<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
    <RootNamespace>Ulp.Docs.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.41.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Documentation\UserGuide\**\*.md"
             Exclude="..\Documentation\UserGuide\developer\**\*;..\Documentation\UserGuide\legal\COMPLIANCE-REVIEW.md;..\Documentation\UserGuide\legal\PRODUCT-LEGAL.md;..\Documentation\UserGuide\legal\EULA-TEMPLATE.md"
             Link="Content\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\Documentation\UserGuide\assets\**\*"
             Exclude="..\Documentation\UserGuide\assets\**\*.md"
             Link="Content\assets\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\Documentation\UserGuide\reference\generated\*.json"
             Link="Content\reference\generated\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RejectPrivateDocumentation" BeforeTargets="Build;Publish">
    <Error Condition="Exists('..\Documentation\UserGuide\developer') Or Exists('..\Documentation\UserGuide\legal\COMPLIANCE-REVIEW.md') Or Exists('..\Documentation\UserGuide\legal\PRODUCT-LEGAL.md') Or Exists('..\Documentation\UserGuide\legal\EULA-TEMPLATE.md')"
           Text="Private maintainer material must be moved out of the public manual before building the documentation website." />
  </Target>
</Project>
