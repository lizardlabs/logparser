@page "/not-found"
@model NotFoundModel

<section class="empty-state">
    <p class="eyebrow">404 · Page not found</p>
    <h1>That documentation page is not here.</h1>
    <p>The page may have moved, or the link may be incomplete. Search the manual or return to the documentation home.</p>
    <div class="hero-actions center-actions">
        <a class="button button-primary" href="/">Documentation home</a>
        <a class="button" href="/search">Search the manual</a>
    </div>
</section>

